# Copy to .env for local development (npm run dev reads the environment; use `set -a; . ./.env; set +a`).

# PostgreSQL 14+.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kgotla

# 32+ random characters. Keys identifier hashing, share links and signed ID codes.
# Changing it invalidates every stored national ID hash: generate once per country cell and keep it in a vault.
KGOTLA_SECRET=

# Demo mode seeds example people, shows SMS codes on screen and adds demo wallet credit.
# It refuses to start with NODE_ENV=production.
DEMO_MODE=true
NODE_ENV=development

PORT=8080
PUBLIC_BASE_URL=http://localhost:8080

# Claude assistant (optional). Without a key the assistant runs in basic keyword mode.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Security tuning
SESSION_TTL_HOURS=12
ACTION_TTL_MINUTES=10
PIN_MAX_FAILURES=5
PIN_LOCK_MINUTES=15

# Country cell: BW, ZA, NA, ZM or ZW. Sets ID format, phone numbers, currency, agencies,
# billers and demo data. A database belongs to one country; the app refuses to start
# against another country's database.
KGOTLA_COUNTRY=BW

# Hosted cells (set by infra/ on Azure; leave unset locally)
# KGOTLA_CLOUD=true            secrets become mandatory even in demo mode
# PGHOST/PGUSER/PGDATABASE     used instead of DATABASE_URL
# PGSSLMODE=require
# PGAUTH=entra                 sign in to PostgreSQL with the managed identity, no password
# AZURE_CLIENT_ID=             client ID of that identity
# DEMO_OFFICER_PASSWORD=       demo officer password (default kgotla-demo locally)

# --- Live cells -------------------------------------------------------------
# Sign-up: mock (demo registry) or open (people declare details, SMS-verified, assurance level 2)
# REGISTRY_MODE=open
# First admin in a live cell (12+ characters); created only if no admin exists
# ADMIN_BOOTSTRAP_PASSWORD=

# PayPal (Orders v2). sandbox or live. Charges in PAYPAL_CURRENCY at PAYPAL_FX_RATE local units per 1 USD.
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_ENV=sandbox
# PAYPAL_CURRENCY=USD
# PAYPAL_FX_RATE=13.6

# DPO Pay (cards and mobile money, API v6)
# DPO_COMPANY_TOKEN=
# DPO_SERVICE_TYPE=
# DPO_API_URL=https://secure.3gdirectpay.com/API/v6/
# DPO_PAY_URL=https://secure.3gdirectpay.com/payv2.php?ID=

# Twilio SMS
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+14155550123
# TWILIO_MESSAGING_SERVICE_SID=
