# Copy to .env for local development (npm run dev reads the environment; use `set -a; . ./.env; set +a`).

# PostgreSQL 14+.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kgotla

# 32+ random characters. Keys identifier hashing, share links and signed ID codes.
# Changing it invalidates every stored Omang hash: generate once per country cell and keep it in a vault.
KGOTLA_SECRET=

# Demo mode seeds example people, shows SMS codes on screen and adds demo wallet credit.
# It refuses to start with NODE_ENV=production.
DEMO_MODE=true
NODE_ENV=development

PORT=8080
PUBLIC_BASE_URL=http://localhost:8080

# Claude assistant (optional). Without a key the assistant runs in basic keyword mode.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Security tuning
SESSION_TTL_HOURS=12
ACTION_TTL_MINUTES=10
PIN_MAX_FAILURES=5
PIN_LOCK_MINUTES=15

# Country cell
KGOTLA_COUNTRY=BW
KGOTLA_CURRENCY=BWP
KGOTLA_UTC_OFFSET=+02:00
